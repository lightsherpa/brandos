          ]
        },
        {
          "day_offset": 6,
          "purpose": "convert: invite readers to visit the site and choose their cheesecake",
          "subject": "Ready to share some happiness? 💛",
          "preheader": "Pick your cheesecake at thecake-me.com and bring a little joy to the table, whenever you're ready.",
          "headline": "Go on, pick your happy! 🌟",
          "body_blocks": [
            "You've met us, you've peeked at the cheesecakes, and now it's your turn!",
            "Your next memorable moment is waiting, and so are we. Whether it's a big celebration or a small everyday win, we're here to make it a little sweeter.",
            "Come say hi at thecake-me.com and find the cheesecake that feels like you. We can't wait to celebrate with you! 🩷"
          ],
          "cta": {
            "label": "Visit Cake-me",
            "url": "https://thecake-me.com"
          },
          "claims": [
            "Cake-me's cheesecakes are available to browse at thecake-me.com",

+  const primary = spec?.payload?.modelRouting?.primary;
+  const fallback = spec?.payload?.modelRouting?.fallback;
+  if (typeof fallback !== "string" || fallback === primary) {
+    yield* streamRoute({ route: primary, spec, system, messages, maxTokens, telemetry });
+    return;
+  }
+  const it = streamRoute({ route: primary, spec, system, messages, maxTokens, telemetry })[Symbol.asyncIterator]();
+  let first;
+  try {
+    first = await Promise.race([
+      it.next(),
+      new Promise((_, rej) => setTimeout(() => rej(new Error("timeout: no first token")), FIRST_TOKEN_TIMEOUT_MS)),
+    ]);
+  } catch (err) {
+    it.return?.().catch(() => {});
+    first = { done: false, value: { type: "error", message: err?.message || String(err) } };
+  }
+  const failedEarly = !first.done && first.value?.type === "error" && isRetryableError(first.value.message);
+  if (failedEarly) {
+    console.warn(`[router] primary ${primary} failed (${first.value.message}); falling back to ${fallback}`);
+    for await (const ev of streamRoute({ route: fallback, spec, system, messages, maxTokens, telemetry })) {
+      if (ev?.type === "done" && ev.usage) ev.usage = { ...ev.usage, fallback_from: primary };
+      yield ev;
+    }
+    return;
+  }
+  if (!first.done) yield first.value;
+  for (let n = await it.next(); !n.done; n = await it.next()) yield n.value;
+}
+
+async function* streamRoute({ route, spec, system, messages, maxTokens, telemetry = {} }) {

+   token within FIRST_TOKEN_TIMEOUT_MS. Never switch mid-stream (would duplicate text). */
+export const FIRST_TOKEN_TIMEOUT_MS = Number(process.env.MODEL_FIRST_TOKEN_TIMEOUT_MS || 20000);
+const RETRYABLE = /\b(429|500|502|503|504|529|404)\b|overloaded|rate.?limit|timeout|network|ECONNRESET|ETIMEDOUT|not.?found|no such model/i;
+export function isRetryableError(message) { return RETRYABLE.test(String(message || "")); }

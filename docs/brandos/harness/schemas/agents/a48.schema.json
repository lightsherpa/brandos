{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a48.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "module_order",
  "header_image",
  "notes"
 ],
 "properties": {
  "agent": {
   "const": "a48"
  },
  "module_order": {
   "description": "module ids"
  },
  "header_image": {
   "description": "{url, width:1200, height:600, alt}"
  },
  "notes": {
   "description": "\u226460 words"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
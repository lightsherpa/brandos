{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a07.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "names",
  "shortlist"
 ],
 "properties": {
  "agent": {
   "const": "a07"
  },
  "names": {
   "description": "{name, strategy, rationale \u226425 words, pronunciation_es, pronunciation_en, tm_risk(low|med|high), notes}"
  },
  "shortlist": {
   "description": "names"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
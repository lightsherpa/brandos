{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a25.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "template_variant"
 ],
 "properties": {
  "agent": {
   "const": "a25"
  },
  "template_variant": {
   "description": "hero_left|hero_centred"
  },
  "message_spec_writes": {
   "type": "object",
   "properties": {
    "blocks.landing": {
     "description": "per message-spec.schema.json"
    }
   }
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a22.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "label_layout",
  "renders",
  "missing_mandatories"
 ],
 "properties": {
  "agent": {
   "const": "a22"
  },
  "label_layout": {
   "description": "{format, dimensions_mm, zones[{name, content, type_style, priority}]}"
  },
  "renders": {
   "description": "{url, angle, overlay_text_exact[]}"
  },
  "missing_mandatories": {
   "description": "string"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
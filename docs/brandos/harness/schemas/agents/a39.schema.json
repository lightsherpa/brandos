{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a39.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "name_line",
  "short_description",
  "benefit_ladder",
  "specs",
  "seo_title",
  "meta_description"
 ],
 "properties": {
  "agent": {
   "const": "a39"
  },
  "name_line": {
   "description": "\u226460"
  },
  "short_description": {
   "description": "\u2264300"
  },
  "benefit_ladder": {
   "description": "{feature, benefit, feeling}"
  },
  "specs": {
   "description": "{label, value, source}"
  },
  "seo_title": {
   "description": "\u226460"
  },
  "meta_description": {
   "description": "\u2264155"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
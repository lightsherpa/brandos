{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a10.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "original",
  "why_tired",
  "reframes"
 ],
 "properties": {
  "agent": {
   "const": "a10"
  },
  "original": {
   "description": "string"
  },
  "why_tired": {
   "description": "string"
  },
  "reframes": {
   "description": "{lever, spine \u22648 words, execution_example, risk}"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
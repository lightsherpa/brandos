{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a53.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "primary_query",
  "cluster",
  "outline",
  "faq",
  "sources"
 ],
 "properties": {
  "agent": {
   "const": "a53"
  },
  "primary_query": {
   "description": "string"
  },
  "cluster": {
   "description": "{query, intent, volume|null, source}"
  },
  "outline": {
   "description": "{h2, h3[]}"
  },
  "faq": {
   "description": "{q, a_brief}"
  },
  "sources": {
   "description": "{url, fetched_at}"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a31.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "pages",
  "site_score"
 ],
 "properties": {
  "agent": {
   "const": "a31"
  },
  "pages": {
   "description": "{url, fetched_at, scores{voice,visual,claims}, violations[{rule_id, quote}]}"
  },
  "site_score": {
   "description": "1\u20135"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
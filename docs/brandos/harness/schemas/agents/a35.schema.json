{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a35.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "direction",
  "tiles",
  "layout_order"
 ],
 "properties": {
  "agent": {
   "const": "a35"
  },
  "direction": {
   "description": "{lens, light, mood_words[3], palette_hex[]}"
  },
  "tiles": {
   "description": "{role(texture|scene|detail|material), url, alt}"
  },
  "layout_order": {
   "description": "tile roles"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a01.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "owns",
  "drift",
  "tension",
  "implication_for_brief",
  "confidence"
 ],
 "properties": {
  "agent": {
   "const": "a01"
  },
  "owns": {
   "description": "{asset, evidence}"
  },
  "drift": {
   "description": "{issue, evidence}"
  },
  "tension": {
   "description": "1 sentence"
  },
  "implication_for_brief": {
   "description": "\u226460 words"
  },
  "confidence": {
   "description": "0\u20131"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
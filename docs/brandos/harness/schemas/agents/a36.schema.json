{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a36.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "spine",
  "rationale",
  "motif",
  "example_deliverables",
  "implied_refusal"
 ],
 "properties": {
  "agent": {
   "const": "a36"
  },
  "spine": {
   "description": "\u22646 words"
  },
  "rationale": {
   "description": "3 sentences"
  },
  "motif": {
   "description": "{type, rule}"
  },
  "example_deliverables": {
   "description": "string"
  },
  "implied_refusal": {
   "description": "string"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
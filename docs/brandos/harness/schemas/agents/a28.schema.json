{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a28.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "logline",
  "approach",
  "shots",
  "cuts"
 ],
 "properties": {
  "agent": {
   "const": "a28"
  },
  "logline": {
   "description": "\u226425 words"
  },
  "approach": {
   "description": "\u2264150 words"
  },
  "shots": {
   "description": "{id, duration_s, camera, action, audio, on_screen_text|null}"
  },
  "cuts": {
   "description": "{duration_s, shot_ids[]}"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
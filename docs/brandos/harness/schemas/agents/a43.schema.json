{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a43.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "layouts",
  "print_notes"
 ],
 "properties": {
  "agent": {
   "const": "a43"
  },
  "layouts": {
   "description": "{format, url, headline_exact, logo_zone, bleed_mm, safe_area_mm, alt}"
  },
  "print_notes": {
   "description": "colour profile, min resolution, what must be rebuilt in DTP"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a40.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "release",
  "bios",
  "to_confirm"
 ],
 "properties": {
  "agent": {
   "const": "a40"
  },
  "release": {
   "description": "{headline, subhead, dateline, body, boilerplate, contact_placeholder}"
  },
  "bios": {
   "description": "{person, length, text}"
  },
  "to_confirm": {
   "description": "string"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
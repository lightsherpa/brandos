{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a06.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "territories",
  "recommendation"
 ],
 "properties": {
  "agent": {
   "const": "a06"
  },
  "territories": {
   "description": "{id, axis, name, core_thought, why_it_ladders{text,bio_ref}, white_space, sample_headline, sample_visual, extensibility[3], risk, scores}"
  },
  "recommendation": {
   "description": "{id, why, why_not_others}"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
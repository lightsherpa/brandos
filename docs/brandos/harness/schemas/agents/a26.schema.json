{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a26.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "merge_tags"
 ],
 "properties": {
  "agent": {
   "const": "a26"
  },
  "merge_tags": {
   "description": "whitelisted tags used"
  },
  "message_spec_writes": {
   "type": "object",
   "properties": {
    "blocks.email": {
     "description": "per schema"
    }
   }
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
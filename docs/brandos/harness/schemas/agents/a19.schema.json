{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a19.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "directions",
  "handoff_note"
 ],
 "properties": {
  "agent": {
   "const": "a19"
  },
  "directions": {
   "description": "{name, idea \u226440 words, svg_url, svg_reversed_url, colours_hex[], min_size_px, risks[]}"
  },
  "handoff_note": {
   "description": "what a designer must refine"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brandos.dev/schemas/agents/a47.v1.json",
 "type": "object",
 "required": [
  "agent",
  "status",
  "self_check",
  "tokens",
  "components",
  "contrast_report"
 ],
 "properties": {
  "agent": {
   "const": "a47"
  },
  "tokens": {
   "description": "DTCG JSON"
  },
  "components": {
   "description": "{name, anatomy[], states[], token_refs{}}"
  },
  "contrast_report": {
   "description": "{pair, ratio, pass}"
  },
  "message_spec_writes": {
   "type": "object"
  },
  "variant": {
   "type": "string"
  },
  "variant_axis": {
   "type": "string"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check_id",
     "pass"
    ],
    "properties": {
     "check_id": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "array"
  },
  "needs_human": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "ok",
    "flagged",
    "needs_input"
   ]
  }
 }
}
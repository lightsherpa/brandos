+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { editBriefInput, replaceDraftAnalysis } from './brief-draft-review.js';
+
+const analysis = (questions) => ({ questions: questions.map((q) => ({ q })), title: 'Saved analysis' });
+const fixture = () => ({ input: 'Original brief', mode: 'flow', qStep: 1, sharpData: analysis(['Who is this for?', 'When is launch?']), answers: { 0: 'Existing customers', 1: 'September' }, answerHistory: [] });
+
+test('editing the brief preserves entered answers and their original question context', () => {
+  const original = fixture();
+  const next = editBriefInput(original, 'Updated brief');
+  assert.equal(next.input, 'Updated brief');
+  assert.deepEqual(next.answers, original.answers);
+  assert.deepEqual(next.sharpData, original.sharpData);
+  assert.equal(next.mode, original.mode);
+  assert.equal(original.input, 'Original brief');
+});
+
+test('successful analysis matches answers by question text when questions reorder', () => {
+  const original = fixture();
+  const replacement = analysis(['When is launch?', 'Who is this for?', 'Which channel?']);
+  const next = replaceDraftAnalysis(original, replacement);
+  assert.deepEqual(next.answers, { 0: 'September', 1: 'Existing customers', 2: '' });
+  assert.deepEqual(next.sharpData, replacement);
+  assert.deepEqual(next.answerHistory, []);
+  assert.equal(next.input, original.input);
+  assert.deepEqual(original.answers, { 0: 'Existing customers', 1: 'September' });
+});
+
+test('answers to removed questions remain recoverable alongside existing history', () => {
+  const original = fixture();
+  original.answerHistory = [{ question: 'What tone?', answer: 'Friendly' }];
+  const next = replaceDraftAnalysis(original, analysis(['When is launch?']));
+  assert.deepEqual(next.answers, { 0: 'September' });
+  assert.deepEqual(next.answerHistory, [
+    { question: 'What tone?', answer: 'Friendly' },
+    { question: 'Who is this for?', answer: 'Existing customers' },
+  ]);
+  assert.deepEqual(original.answerHistory, [{ question: 'What tone?', answer: 'Friendly' }]);
+});
+
+test('repeated analysis does not duplicate a recovered question and answer', () => {
+  const original = fixture();
+  original.answerHistory = [{ question: 'Who is this for?', answer: 'Existing customers' }];
+  const next = replaceDraftAnalysis(original, analysis(['When is launch?']));
+  assert.deepEqual(next.answerHistory, original.answerHistory);
+  const repeated = replaceDraftAnalysis(next, analysis(['When is launch?']));
+  assert.deepEqual(repeated.answerHistory, original.answerHistory);
+});
+
+test('different answers to the same removed question remain separately recoverable', () => {
+  const original = fixture();
+  original.answerHistory = [{ question: 'Who is this for?', answer: 'New customers' }];
+  const next = replaceDraftAnalysis(original, analysis(['When is launch?']));
+  assert.deepEqual(next.answerHistory, [
+    { question: 'Who is this for?', answer: 'New customers' },
+    { question: 'Who is this for?', answer: 'Existing customers' },
+  ]);
+});
+
+test('unanswered removed questions do not create empty recovery records', () => {
+  const original = fixture();
+  original.answers = { 0: '', 1: 'September' };
+  const next = replaceDraftAnalysis(original, analysis(['When is launch?']));
+  assert.deepEqual(next.answerHistory, []);
+});
+
+test('legacy drafts without answer history retain removed answers', () => {
+  const original = fixture();
+  delete original.answerHistory;
+  const next = replaceDraftAnalysis(original, analysis([]));
+  assert.deepEqual(next.answerHistory, [
+    { question: 'Who is this for?', answer: 'Existing customers' },
+    { question: 'When is launch?', answer: 'September' },
+  ]);
+});
diff --git a/src/lib/brief-draft-store.js b/src/lib/brief-draft-store.js
new file mode 100644
index 0000000..e136f0d
--- /dev/null
+++ b/src/lib/brief-draft-store.js
@@ -0,0 +1,162 @@
+import { emptyDraft, isDraftPayload, isUuid, isRevision, isObject } from "../../shared/brief-draft-payload.js";
+export { emptyDraft };
+
+
+// One controller per user/brand. Writes are serialized; every retry reuses its
+// mutation ID. Recovery entries are per editor, so two tabs cannot erase each
+// other's unsaved text. Server revisions arbitrate concurrent saves.
+export function createBriefDraftStore({ userId, brandId, request, storage, uuid = () => crypto.randomUUID(), delay = 600 }) {
+  const prefix = `ci_brief_draft:v1:${userId}:${brandId}:`;
+  let state = { payload: emptyDraft(), id: null, revision: 0, drafts: [], status: "loading", error: null, ready: false, workspaceId: null, localError: false };
+  let timer, flight, pending = null, dirty = false, recoveryKey = prefix + uuid(), sourceKey = null, sourceValue = null;
+  let generation = 0, loadSequence = 0, disposed = false, initialized = false;
+  const listeners = new Set();
+  const emit = (patch = {}) => { state = { ...state, ...patch }; listeners.forEach((fn) => fn()); };
+  const localEntries = () => {
+    const rows = [];
+    try {
+      for (let i = 0; i < storage.length; i++) {
+        const key = storage.key(i);
+        if (!key?.startsWith(prefix)) continue;
+        try {
+          const raw = storage.getItem(key), record = JSON.parse(raw);
+          const validPending = record?.pending == null || (isObject(record.pending)
+            && record.pending.ownerUserId === userId && record.pending.brandId === brandId
+            && record.pending.workspaceId === record.workspaceId
+            && isRevision(record.pending.revision) && record.pending.revision === record.revision
+            && isUuid(record.pending.mutationId) && isDraftPayload(record.pending.payload, false));
+          if (isObject(record) && isUuid(record.id) && isRevision(record.revision)
+            && isDraftPayload(record.payload, false) && validPending
+            && (record.workspaceId == null || typeof record.workspaceId === "string")
+            && record.userId === userId && record.brandId === brandId) rows.push({ ...record, recoveryKey: key, raw });
+        } catch { /* Ignore an invalid recovery record, never another scope. */ }
+      }
+    } catch { emit({ localError: true }); }
+    return rows.sort((a, b) => b.at - a.at);
+  };
+  const persist = () => {
+    if (!state.id || !dirty) return;
+    try {
+      storage.setItem(recoveryKey, JSON.stringify({ id: state.id, revision: state.revision, workspaceId: state.workspaceId, userId, brandId, payload: state.payload, pending, at: Date.now() }));
+      emit({ localError: false });
+    } catch { emit({ localError: true }); }
+  };
+  const removeRecovery = () => {
+    try {
+      storage.removeItem(recoveryKey);
+      // Don't erase a recovery copy another editor has since changed.
+      if (sourceKey && storage.getItem(sourceKey) === sourceValue) storage.removeItem(sourceKey);
+      sourceKey = null;
+    } catch { /* Server has acknowledged the save. */ }
+  };
+  async function json(path, init) {
+    const response = await request(path, init);
+    const data = await response.json();
+    if (!response.ok) { const e = new Error(data.error || "Draft request failed"); e.code = data.code; e.status = response.status; throw e; }
+    return data;
+  }
+  function adopt(row) {
+    generation++;
+    pending = row?.pending || null;
+    dirty = !!row?.recoveryKey;
+    sourceKey = row?.recoveryKey || null;
+    sourceValue = row?.raw || null;
+    recoveryKey = prefix + uuid();
+    emit({ id: row?.id || null, revision: row?.revision || 0, payload: row?.payload || emptyDraft(), status: dirty ? "unsaved" : row ? "saved" : "idle", error: null });
+  }
+  async function load() {
+    disposed = false;
+    const sequence = ++loadSequence;
+    emit({ status: "loading", error: null });
+    try {
+      const result = await json(`/api/briefs/drafts?brandId=${encodeURIComponent(brandId)}&ownerUserId=${encodeURIComponent(userId)}`);

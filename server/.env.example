# Copy to .env and fill in
ANTHROPIC_API_KEY=

# Supabase (staging) — Dashboard → Settings → API
# Service role key is SERVER-SIDE ONLY. Never ship to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OPEX override token signing (HMAC-SHA-256). REQUIRED in production.
# Generate a dedicated value: openssl rand -base64 32
# If unset, server/src/lib/opex-override.js falls back to SUPABASE_SERVICE_ROLE_KEY,
# which couples database-key rotation to override-token validity. Never reuse another key.
OPEX_OVERRIDE_SECRET=

# Discovery delegation magic-link digest pepper (HMAC-SHA-256). CAA-51.
# Generate a dedicated value: openssl rand -base64 32
# Delegation tokens are stored ONLY as a one-way digest. With this set the
# digest is HMAC-SHA-256; without it, a domain-separated SHA-256 (still not
# reversible — the token is 256 bits of CSPRNG — but you lose the revocation
# lever). ROTATING THIS VALUE INVALIDATES EVERY PENDING DELEGATION LINK, which
# is the intended way to mass-revoke them.
DELEGATION_TOKEN_PEPPER=

# Delegation magic-link lifetime in days. Default 7.
DELEGATION_TTL_DAYS=7

# OpenRouter — for non-Claude text models (GPT-5, Gemini Flash, etc.)
# per the hybrid routing decision in docs/2026-05-24-engineering-refinement.md
# (Anthropic direct for caching; OpenRouter for everything else text).
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# fal.ai — image specialists (a19/a20/a21/a22/a23). One key hosts
# Flux 1.1 Pro, Flux schnell, Recraft, SDXL, vision models for a24 QA.
# Sign up: https://fal.ai/dashboard/keys
FAL_API_KEY=

# Optional — defaults shown
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MODEL=claude-sonnet-4-6

# ── API perimeter (server/src/lib/http-policy.js) ────────────────────────────
# All optional. The compiled-in defaults are correct for local dev and for the
# single Render web service; these exist so ops can tighten without a deploy.
#
# TRUST_PROXY — read X-Forwarded-For for the rate-limit client IP. Defaults ON
#   when NODE_ENV=production, OFF otherwise. Leave OFF locally: with no proxy in
#   front, a caller could set the header and rotate buckets at will.
# TRUSTED_PROXY_HOPS — proxies between the internet and this process (Render=1;
#   raise to 2 behind a CDN). The client is counted from the RIGHT of the chain.
# RATE_LIMIT_DISABLED — escape hatch for load scripts / local smoke runs.
# CSP_MODE — enforce | report-only | off. Defaults to enforce in production,
#   off elsewhere (in dev Vite serves the SPA document, not this app).
# CSP_CONNECT_SRC — extra comma-separated connect-src origins, if the SPA ever
#   needs to reach a host beyond same-origin + Supabase.
# Per-class ceilings: RATE_LIMIT_<CLASS>_IP_MAX / _USER_MAX / _WINDOW_MS and
#   BODY_LIMIT_<CLASS>_BYTES. PAID and PAID_RUN also honor _GLOBAL_MAX.
#   CLASS is HEALTH | WEBHOOK | PUBLIC_TOKEN | UPLOAD | GENERATION | PAID |
#   PAID_RUN | API | ASSET.
TRUST_PROXY=0
TRUSTED_PROXY_HOPS=1

# BIO Discovery v2 pipeline: multi-page crawl + uploaded sources + Instagram + visual extraction.
# Off by default (single-page, cheap). Set to 1 to enable the full accuracy pipeline.
DISCOVERY_V2=0

# Firecrawl — web scraping for Discovery v2 multi-page crawl.
# REQUIRED whenever DISCOVERY_V2=1 (compile-bio throws without it). Sign up: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Inngest — background job queue (BIO compilation).
# LOCAL DEV: leave the two keys blank and set INNGEST_DEV=1 to use the local dev server.
# PRODUCTION: remove INNGEST_DEV, set both keys from the Inngest Cloud dashboard,
# and register the app URL https://<your-host>/api/inngest there.
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public origin of the deployed app (single-origin: same host serves API + SPA).
# Used for Stripe checkout success/cancel return URLs. Dev: http://localhost:5173
APP_URL=http://localhost:5173

# Stripe — self-serve tier upgrades (Day 3). Server-side only, never VITE_.
# Create two recurring Prices (01 Dam, 02 River) + a webhook endpoint in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DAM=
STRIPE_PRICE_RIVER=

# Resend — transactional/notification email. Without it, notifications degrade
# to in-app only (sends are skipped with a warning). Sign up: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=CaastorOS <notifications@caastoros.com>

# Demo-only multi-format preview (email, landing, 3-slide deck) from an existing
# brief + BIO. Off unless 1. The SPA flag VITE_FORMAT_PREVIEW must match, and
# Vite bakes it at build time — set both before `npm run build` for a booth demo.
FORMAT_PREVIEW=0

# Task pipeline (/api/tasks + Tasks nav). Default off.
TASKS_ENABLED=false

# Simplified CD approval + durable progress (enable frontend and API together)
CERTIFY_SIMPLIFY=0

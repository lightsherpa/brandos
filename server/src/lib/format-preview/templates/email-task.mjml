<mjml lang="{{language}}">
  <mj-head>
    <mj-title>{{email.subject}}</mj-title>
    <mj-preview>{{email.preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="{{tokens.font_body}}" color="{{tokens.ink}}" />
      <mj-text font-size="16px" line-height="1.6" />
      <mj-button background-color="{{tokens.primary}}" color="{{tokens.cta_text}}" border-radius="4px" font-weight="bold" font-size="19px" inner-padding="14px 28px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{tokens.surface}}" width="600px">
    <mj-section padding="24px 0 12px"><mj-column>
      {{#if tokens.logo_url}}<mj-image src="{{tokens.logo_url}}" alt="{{brand_name}}" width="140px" padding="0" />{{/if}}
      {{#if tokens.no_logo}}<mj-text font-family="{{tokens.font_display}}" font-size="20px" align="center">{{brand_name}}</mj-text>{{/if}}
    </mj-column></mj-section>
    {{#if hero.src}}<mj-section padding="0"><mj-column>
      <mj-image src="{{hero.src}}" alt="{{hero.alt}}" padding="0" />
    </mj-column></mj-section>{{/if}}
    <mj-section background-color="#ffffff" padding="28px 24px"><mj-column>
      <mj-text font-family="{{tokens.font_display}}" font-size="28px" line-height="1.2">{{email.headline}}</mj-text>
      {{#each email.body_blocks}}<mj-text>{{@}}</mj-text>{{/each}}
      <mj-button href="{{email.cta.url}}" css-class="cta-primary" padding-top="20px">{{email.cta.label}}</mj-button>
    </mj-column></mj-section>
    <mj-section padding="16px 24px"><mj-column>
      <mj-divider border-color="{{tokens.primary}}" border-width="2px" width="48px" />
      <mj-text font-size="12px" color="{{tokens.muted}}" align="center">{{footer}}</mj-text>
    </mj-column></mj-section>
  </mj-body>
</mjml>

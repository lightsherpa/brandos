{
  "$id": "https://brandos.dev/schemas/email-spec.v1.json",
  "type": "object",
  "required": ["task", "language", "smp", "emails"],
  "additionalProperties": false,
  "properties": {
    "task": {"const": "email_sequence"},
    "language": {"type": "string"},
    "smp": {"type": "string", "maxLength": 200},
    "emails": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
      "type": "object",
      "required": ["day_offset", "purpose", "subject", "preheader", "headline", "body_blocks", "cta"],
      "additionalProperties": false,
      "properties": {
        "day_offset": {"type": "integer", "minimum": 0, "maximum": 60},
        "purpose": {"type": "string", "maxLength": 160},
        "subject": {"type": "string", "minLength": 1, "maxLength": 120},
        "preheader": {"type": "string", "maxLength": 200},
        "headline": {"type": "string", "maxLength": 120},
        "body_blocks": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "maxLength": 1200}},
        "cta": {"type": "object", "required": ["label", "url"], "additionalProperties": false, "properties": {"label": {"type": "string", "maxLength": 40}, "url": {"type": "string"}}},
        "claims": {"type": "array", "items": {"type": "string"}},
        "hero_image_brief": {"$ref": "https://brandos.dev/schemas/image-brief.v1.json"}
      }
    }}
  }
}

{
  "name": "caastoros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cd server && node --env-file-if-exists=.env src/index.js",
    "dev:server": "cd server && npm run dev",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:8787/api/inngest",
    "dev:all": "concurrently -k -n web,api,inngest -c yellow,cyan,magenta \"npm run dev\" \"npm run dev:server\" \"npm run dev:inngest\"",
    "seed:specs": "node --env-file=server/.env scripts/seed-specs.mjs",
    "test:router": "node --env-file=server/.env scripts/test-router.mjs",
    "test:discovery": "node --env-file=server/.env scripts/test-discovery.mjs",
    "grant:steward": "node --env-file=server/.env scripts/grant-steward.mjs",
    "test:recovery": "node --env-file=server/.env scripts/test-recovery-link.mjs",
    "test:run": "node --env-file=server/.env scripts/test-run.mjs",
    "test:gate": "node scripts/test-gate.mjs",
    "test:cert-flow": "node scripts/test-cert-flow.mjs",
    "test:discovery-flow": "node scripts/test-discovery-flow.mjs",
    "test:plan": "node --env-file=server/.env scripts/test-delivery-plan.mjs",
    "test:units": "node scripts/test-suite.mjs --unit",
    "test:db": "npx supabase test db supabase/tests/platform_integrity.sql",
    "test:delegation": "node --experimental-test-module-mocks --test server/src/routes/discovery-delegation.test.mjs",
    "test:deliverables": "node --env-file=server/.env scripts/test-deliverables.mjs",
    "bench:image": "node --env-file=server/.env scripts/bench-image.mjs",
    "postinstall": "npm ci --prefix server",
    "test:foundation": "node --experimental-test-module-mocks --test server/src/routes/foundation-preflight.test.mjs server/src/routes/foundation-edit.test.mjs",
    "preview:social": "node scripts/compose-social-preview.mjs",
    "test:certifier-db": "node --test scripts/certifier-durable-db.test.mjs",
    "test:office": "node --test src/lib/office-model.test.mjs src/brand-scope-flow.test.mjs src/pixel-office/layouts.test.mjs src/lib/studio-state.test.mjs src/lib/agency-avatars.test.mjs src/lib/generated-office-layout.test.mjs src/lib/office-surfaces.test.mjs src/lib/office-customization.test.mjs src/brief-workspace-surface.test.mjs",
    "test:reference-intake-db": "node --test scripts/reference-intake-db.test.mjs",
    "test:migration-replay": "node --test scripts/migration-replay.test.mjs",
    "test:output-status-db": "node --test server/src/harness/output-status-db.test.mjs",
    "test": "node scripts/test-suite.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "inngest": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "vite": "^5.4.11"
  }
}
